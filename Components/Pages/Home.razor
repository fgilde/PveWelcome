@page "/"
@layout BlankLayout
@inject LandingService Landing
@inject IHttpContextAccessor Http

<PageTitle>@(page?.Name ?? "Home")</PageTitle>

@if (page is not null)
{
    <style>@((MarkupString)page.Css)</style>
    @((MarkupString)page.Html)

    @if (page.LoginEnabled)
    {
        <style>
            .lp-login{position:fixed;top:1rem;right:1rem;z-index:9999;padding:.45rem .9rem;border-radius:999px;
              background:#00000066;color:#fff;text-decoration:none;font:600 .82rem Inter,system-ui,sans-serif;
              border:1px solid #ffffff33;backdrop-filter:blur(6px)}
            .lp-login:hover{background:#000000aa}
        </style>
        <a class="lp-login" href="/login">Login</a>
    }

    @if (!string.IsNullOrWhiteSpace(page.Js))
    {
        <script>@((MarkupString)page.Js)</script>
    }
}
else
{
    <p style="color:#888;font-family:sans-serif;padding:2rem">Keine Landing-Seite konfiguriert.</p>
}

@code {
    private LandingPage? page;
    protected override void OnInitialized() => page = Landing.Resolve(Http.HttpContext?.Request.Host.Value);
}
