@page "/pc"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@using PveWelcome.Models
@inject PhysicalMachineService Svc

<PageTitle>@Loc.T("Rechner")</PageTitle>

<TopBar />

<div class="page-wrap">
    <h1>@Loc.T("Rechner")</h1>
    <p class="muted">@Loc.T("Physische Rechner im LAN — an- und ausschalten und verbinden.")</p>

    @if (machines.Count == 0 && draft is null)
    {
        <p class="muted">@Loc.T("Noch kein Rechner angelegt.")</p>
    }

    @foreach (var m in machines)
    {
        <div class="settings-card">
            <h2 style="display:flex;align-items:center;gap:.6rem;margin-top:0">
                <span title="@State(m)" style="width:.7rem;height:.7rem;border-radius:50%;display:inline-block;background:@DotColor(m)"></span>
                @m.Name
                <span class="muted" style="font-weight:400;font-size:.9rem">@m.Host · @State(m)</span>
            </h2>

            @if (messages.TryGetValue(m.Id, out var msg) && !string.IsNullOrEmpty(msg))
            {
                <p class="muted">@msg</p>
            }

            <button class="btn sm go" disabled="@(busy.Contains(m.Id) || online.GetValueOrDefault(m.Id))"
                    @onclick="() => Wake(m)">@Loc.T("Einschalten")</button>
            <button class="btn sm danger" disabled="@(busy.Contains(m.Id) || !online.GetValueOrDefault(m.Id))"
                    @onclick="() => Shutdown(m)">@Loc.T("Herunterfahren")</button>

            @{ var guac = PhysicalMachineService.GuacUrl(m); }
            @if (guac is not null)
            {
                <a class="btn sm" href="@guac" target="_blank" rel="noopener">@Loc.T("Im Browser verbinden")</a>
            }
            <span class="dropdown" style="display:inline-block">
                <button type="button" class="btn sm">@Loc.T(".rdp herunterladen") <span class="caret">▾</span></button>
                <div class="drop-menu">
                    <a href="/pc.rdp?id=@m.Id&multimon=true">🖥️🖥️ @Loc.T("Alle Monitore")</a>
                    <a href="/pc.rdp?id=@m.Id&multimon=false">🖥️ @Loc.T("Ein Monitor")</a>
                </div>
            </span>

            <AuthorizeView Roles="Admin" Context="admin">
                <button class="btn sm" @onclick="() => ToggleConsole(m)">@Loc.T("Terminal")</button>
                <button class="btn sm" @onclick="() => Edit(m)">@Loc.T("Bearbeiten")</button>
            </AuthorizeView>

            <AuthorizeView Roles="Admin" Context="term">
                @if (consoleOpen.Contains(m.Id))
                {
                    <div style="margin-top:.8rem">
                        <div style="display:flex;gap:.4rem">
                            <input style="flex:1;font-family:monospace" placeholder="@Loc.T("Befehl auf dem Rechner ausführen…")"
                                   @bind="consoleCmd" @bind:event="oninput"
                                   @onkeydown="@(e => { if (e.Key == "Enter") _ = RunCommand(m); })" />
                            <button class="btn sm go" disabled="@busyConsole.Contains(m.Id)"
                                    @onclick="() => RunCommand(m)">@Loc.T("Ausführen")</button>
                        </div>
                        @if (consoleOut.TryGetValue(m.Id, out var outp) && !string.IsNullOrEmpty(outp))
                        {
                            <pre style="margin-top:.5rem;max-height:20rem;overflow:auto;white-space:pre-wrap">@outp</pre>
                        }
                        <p class="muted" style="font-size:.85rem">
                            @Loc.T("Einzelne Befehle, keine interaktive Sitzung — läuft über den Jump-Host.")
                        </p>
                    </div>
                }
            </AuthorizeView>
        </div>
    }

    <AuthorizeView Roles="Admin">
        @if (draft is not null)
        {
            <div class="settings-card">
                <h2 style="margin-top:0">@(draft.Id == 0 ? Loc.T("Neuer Rechner") : Loc.T("{0} bearbeiten", draft.Name))</h2>
                @MachineForm(draft)
                <button class="btn sm go" @onclick="SaveDraft">@Loc.T("Speichern")</button>
                <button class="btn sm" @onclick="() => draft = null">@Loc.T("Abbrechen")</button>
                @if (draft.Id != 0)
                {
                    <button class="btn sm danger" @onclick="DeleteDraft">@Loc.T("Löschen")</button>
                }
            </div>
        }
        else
        {
            <button class="btn sm go" @onclick="NewMachine">@Loc.T("Neuer Rechner")</button>
        }
    </AuthorizeView>
</div>

@code {
    private RenderFragment<PhysicalMachine> MachineForm => m =>@<div class="settings-grid">
        <label>@Loc.T("Name")<input @bind="m.Name" placeholder="Arbeitsrechner" /></label>
        <label>@Loc.T("Adresse")<input @bind="m.Host" placeholder="10.0.0.5" /></label>
        <label>@Loc.T("Probe-Port")<input type="number" @bind="m.ProbePort" /></label>
        <label>@Loc.T("Benutzer am Rechner")<input @bind="m.OsUser" /></label>
        <label>@Loc.T("MAC (fest eingebrannt)")<input @bind="m.Mac" placeholder="aa:bb:cc:dd:ee:ff" /></label>
        <label>@Loc.T("MAC (Software-Override)")<input @bind="m.MacAlt" /></label>
        <label>@Loc.T("Broadcast")<input @bind="m.Broadcast" /></label>
        <label>@Loc.T("WoL-Port")<input type="number" @bind="m.WolPort" /></label>
        <label>@Loc.T("Jump-Host")<input @bind="m.JumpHost" /></label>
        <label>@Loc.T("Jump-Port")<input type="number" @bind="m.JumpPort" /></label>
        <label>@Loc.T("Jump-Benutzer")<input @bind="m.JumpUser" /></label>
        <label class="chk">@Loc.T("Jump-Auth ist Key")<input type="checkbox" @bind="m.JumpAuthIsKey" /></label>
        <label style="grid-column:1/-1">@Loc.T("Jump-Auth (Key oder Passwort)")
            <textarea rows="4" @bind="m.JumpAuth" placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"></textarea></label>
        <label style="grid-column:1/-1">@Loc.T("SSH-Befehlsmuster (auf dem Jump-Host; {host}, {user}, {cmd} werden ersetzt)")
            <input @bind="m.SshCommandTemplate" /></label>
        <label style="grid-column:1/-1">@Loc.T("Shutdown-Befehl (läuft auf dem Rechner)")
            <input @bind="m.ShutdownCommand" /></label>
        <label>@Loc.T("Guacamole-Domain")<input @bind="m.GuacHost" placeholder="rdp.example.com" /></label>
        <label>@Loc.T("Guacamole-Verbindungs-ID")<input @bind="m.GuacConnectionId" placeholder="1" /></label>
        <label>@Loc.T("Guacamole-Datenquelle")<input @bind="m.GuacDataSource" placeholder="postgresql" /></label>
        <label class="chk">@Loc.T("Aktiv")<input type="checkbox" @bind="m.Enabled" /></label>
    </div>;

    private List<PhysicalMachine> machines = new();
    private readonly Dictionary<int, bool> online = new();
    private readonly Dictionary<int, string> messages = new();
    private readonly HashSet<int> busy = new();
    private readonly HashSet<int> waking = new();
    private readonly HashSet<int> consoleOpen = new();
    private readonly HashSet<int> busyConsole = new();
    private readonly Dictionary<int, string> consoleOut = new();
    private string consoleCmd = "";
    private PhysicalMachine? draft;
    private Timer? timer;
    private readonly CancellationTokenSource cts = new();

    private string State(PhysicalMachine m) =>
        waking.Contains(m.Id) ? Loc.T("startet…")
        : online.GetValueOrDefault(m.Id) ? Loc.T("online")
        : Loc.T("offline");

    private string DotColor(PhysicalMachine m) =>
        waking.Contains(m.Id) ? "#e0a800" : online.GetValueOrDefault(m.Id) ? "#2ea043" : "#6e7681";

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        timer = new Timer(async _ => await Refresh(), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task Reload()
    {
        machines = await Svc.ListAsync();
        await Refresh();
    }

    private async Task Refresh()
    {
        foreach (var m in machines)
        {
            var up = await PhysicalMachineService.IsOnlineAsync(m, cts.Token);
            online[m.Id] = up;
            if (up) waking.Remove(m.Id);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task Wake(PhysicalMachine m)
    {
        busy.Add(m.Id);
        messages[m.Id] = Loc.T("Magic Packet wird gesendet…");
        var result = await Svc.WakeAsync(m, cts.Token);
        busy.Remove(m.Id);
        waking.Add(m.Id);
        messages[m.Id] = result;
        _ = WaitForBoot(m);
    }

    /// Give up after two minutes so the card cannot sit on "startet…" forever.
    private async Task WaitForBoot(PhysicalMachine m)
    {
        var deadline = DateTime.UtcNow.AddMinutes(2);
        while (DateTime.UtcNow < deadline && !cts.IsCancellationRequested)
        {
            await Task.Delay(TimeSpan.FromSeconds(5), cts.Token);
            if (await PhysicalMachineService.IsOnlineAsync(m, cts.Token))
            {
                online[m.Id] = true;
                waking.Remove(m.Id);
                messages[m.Id] = Loc.T("Rechner ist online.");
                await InvokeAsync(StateHasChanged);
                return;
            }
        }
        if (waking.Remove(m.Id))
        {
            messages[m.Id] = Loc.T("Aufwecken fehlgeschlagen — kein Lebenszeichen nach 2 Minuten. BIOS-Einstellung „ErP Ready“ prüfen.");
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Shutdown(PhysicalMachine m)
    {
        busy.Add(m.Id);
        messages[m.Id] = Loc.T("Fahre herunter…");
        messages[m.Id] = await Svc.ShutdownAsync(m, cts.Token);
        busy.Remove(m.Id);
        await Refresh();
    }

    private void ToggleConsole(PhysicalMachine m)
    {
        if (!consoleOpen.Remove(m.Id)) consoleOpen.Add(m.Id);
    }

    private async Task RunCommand(PhysicalMachine m)
    {
        var cmd = consoleCmd.Trim();
        if (cmd.Length == 0) return;
        busyConsole.Add(m.Id);
        consoleOut[m.Id] = $"> {cmd}\n";
        await InvokeAsync(StateHasChanged);
        consoleOut[m.Id] += await Svc.RunRemoteAsync(m, cmd, cts.Token);
        busyConsole.Remove(m.Id);
        consoleCmd = "";
        await InvokeAsync(StateHasChanged);
    }

    private void NewMachine() => draft = new PhysicalMachine();

    /// Edit a detached copy so "Abbrechen" really discards.
    private void Edit(PhysicalMachine m) => draft = new PhysicalMachine
    {
        Id = m.Id, Name = m.Name, Host = m.Host, ProbePort = m.ProbePort, OsUser = m.OsUser,
        Mac = m.Mac, MacAlt = m.MacAlt, Broadcast = m.Broadcast, WolPort = m.WolPort,
        JumpHost = m.JumpHost, JumpPort = m.JumpPort, JumpUser = m.JumpUser,
        JumpAuth = m.JumpAuth, JumpAuthIsKey = m.JumpAuthIsKey,
        SshCommandTemplate = m.SshCommandTemplate, ShutdownCommand = m.ShutdownCommand,
        GuacHost = m.GuacHost, GuacConnectionId = m.GuacConnectionId, GuacDataSource = m.GuacDataSource,
        Enabled = m.Enabled,
    };

    private async Task SaveDraft()
    {
        if (draft is null) return;
        await Svc.SaveAsync(draft);
        draft = null;
        await Reload();
    }

    private async Task DeleteDraft()
    {
        if (draft is null || draft.Id == 0) return;
        await Svc.DeleteAsync(draft.Id);
        draft = null;
        await Reload();
    }

    public void Dispose()
    {
        timer?.Dispose();
        cts.Cancel();
        cts.Dispose();
    }
}
